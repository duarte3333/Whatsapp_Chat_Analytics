@startuml
skinparam classAttributeIconSize 0

'=========================
' Entities
'=========================
class User {
  * Long id
  + String username {unique}
  + String email {unique}
  - String password
  + boolean enabled
  -- Security/Verification --
  + String verificationCode
  + LocalDateTime verificationCodeExpiresAt
  + getAuthorities(): Collection<GrantedAuthority>
  + isAccountNonExpired(): boolean
  + isAccountNonLocked(): boolean
  + isCredentialsNonExpired(): boolean
  + isEnabled(): boolean
}

'TODO: change according to stats
class GroupChat {
  * Long id
  String title
  Long userId (FK)
  int participantsCount
  DateTime createdAt
}

class ChatMetrics {
  * Long id
  Long groupChatId (FK)
  int totalMessages
  Map<String,int> messagesPerSender
  List<String> topWords
  Map<String,int> emojiCounts
  Map<String,float> sentimentScores
  DateTime updatedAt
}


' Relationships
User "1" --> "*" GroupChat
GroupChat "1" --> "*" ChatMetrics

'=========================
' Services
'=========================
class AuthService {
  +register(username, password): User
  +login(username, password): JWT
  +verifyToken(token): Boolean
}

class MetricsService {
  +uploadMetrics(chatMetrics: ChatMetrics): void
  +getMetrics(chatId: Long, userId: Long): ChatMetrics
  +compareMetrics(chatIds: List<Long>, userId: Long): List<ChatMetrics>
}


' Relationships: Services operate on entities
AuthService ..> User
MetricsService ..> ChatMetrics

'=========================
' Client-side module
'=========================
class PythonMicroservice {
  +selectZIP(file): void
  +parseZIP(): ChatMetrics
  +computeMetrics(): ChatMetrics
  +sendMetricsToBackend(chatMetrics: ChatMetrics, groupChatId: Long)
  +uploadZIP(file: File, groupChatId: Long)
}

PythonMicroservice ..> ChatMetrics

@enduml
